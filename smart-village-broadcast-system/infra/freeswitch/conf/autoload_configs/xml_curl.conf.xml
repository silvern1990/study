<configuration name="xml_curl.conf" description="cURL XML Gateway">
  <bindings>
    <!-- SIP 계정(디렉터리)은 백엔드 DB 에서 조회한다 -->
    <binding name="svbs-directory">
      <param name="gateway-url" value="$${svbs_api_url}/freeswitch/directory" bindings="directory"/>
      <param name="gateway-credentials" value="$${svbs_xmlcurl_credentials}"/>
      <param name="auth-scheme" value="basic"/>
      <param name="timeout" value="5"/>
    </binding>
  </bindings>
</configuration>
