PORT=3000
DATABASE_URL=postgres://svbs:svbs@localhost:5432/svbs
DB_SYNCHRONIZE=true
REDIS_HOST=localhost
REDIS_PORT=6379

# 녹음 파일 공유 디렉터리 (FreeSWITCH 컨테이너의 /recordings 와 같은 곳)
RECORDINGS_DIR=../data/recordings
FS_RECORDINGS_DIR=/recordings

FS_ESL_HOST=127.0.0.1
FS_ESL_PORT=8021
FS_ESL_PASSWORD=ClueCon
FS_XMLCURL_USER=freeswitch
FS_XMLCURL_PASSWORD=change-me

# 앱에 내려줄 SIP 접속 정보 (FreeSWITCH 호스트 IP 로 변경)
SIP_DOMAIN=127.0.0.1
SIP_WS_URL=ws://127.0.0.1:5066

BROADCAST_RING_TIMEOUT_SEC=45
BROADCAST_MAX_ATTEMPTS=3
BROADCAST_RETRY_DELAY_SEC=300
BROADCAST_PUSH_PER_SECOND=50
